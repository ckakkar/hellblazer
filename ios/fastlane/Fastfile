# TestFlight builds with no local Mac tooling: .github/workflows/ios.yml runs
# this lane on a GitHub-hosted macOS runner. The signing material comes from
# repo secrets and variables that scripts/ios-signing-setup.mjs creates once.
require "base64"

default_platform(:ios)

BUNDLE_ID = "com.kkrwhofrags.hellblazer"
# The Home Screen widget and rest timer Live Activity ship as an extension.
WIDGETS_ID = "#{BUNDLE_ID}.widgets"
# Absolute paths: fastlane runs Ruby code and actions from different working
# directories, so relative paths are easy to get wrong.
PROJECT = File.join(ENV.fetch("GITHUB_WORKSPACE"), "ios", "App", "App.xcodeproj")
TMP = ENV.fetch("RUNNER_TEMP")

platform :ios do
  desc "Build, sign and upload the app to TestFlight"
  lane :beta do
    # A throwaway keychain for this run, set as the default.
    setup_ci(force: true)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
    )

    p12 = File.join(TMP, "distribution.p12")
    File.binwrite(p12, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12")))
    import_certificate(
      certificate_path: p12,
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD"),
    )

    # One App Store profile per target, each reused or created for our
    # certificate. A profile generated before a capability was switched on
    # is invalid, so sigh makes a fresh one then.
    profiles = {}
    { "App" => BUNDLE_ID, "Widgets" => WIDGETS_ID }.each do |target, identifier|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: identifier,
        cert_id: ENV.fetch("IOS_CERT_ID"),
        output_path: TMP,
        filename: "#{target}.mobileprovision",
      )
      profiles[identifier] = lane_context[SharedValues::SIGH_NAME]

      update_code_signing_settings(
        path: PROJECT,
        targets: [target],
        build_configurations: ["Release"],
        use_automatic_signing: false,
        team_id: ENV.fetch("IOS_TEAM_ID"),
        code_sign_identity: "Apple Distribution",
        profile_name: profiles[identifier],
        bundle_identifier: identifier,
      )
    end

    # Run number, plus the attempt so a re-run still uploads a new build.
    build_number = "#{ENV.fetch('GITHUB_RUN_NUMBER')}.#{ENV.fetch('GITHUB_RUN_ATTEMPT', '1')}"

    build_app(
      project: PROJECT,
      scheme: "App",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: { provisioningProfiles: profiles },
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      output_directory: File.join(TMP, "build"),
    )

    # "What to Test" is set afterwards by scripts/testflight-notes.mjs:
    # fastlane's changelog option writes an attribute Apple has retired.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
